{
  "name": "Project",
  "type": "object",
  "description": "Realizacje prezentowane w portfolio. Zdj\u0119cia i opisy mo\u017cna podmienia\u0107 bez zmian w kodzie strony.",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nazwa realizacji, np. Kuchnia z wysp\u0105 w naturalnym d\u0119bie"
    },
    "category": {
      "type": "string",
      "description": "Kategoria realizacji",
      "enum": [
        "Kuchnie",
        "Szafy i zabudowy",
        "Meble na wymiar"
      ]
    },
    "description": {
      "type": "string",
      "description": "Kr\u00f3tki opis realizacji (1\u20132 zdania)"
    },
    "location": {
      "type": "string",
      "description": "Miejsce realizacji"
    },
    "image_url": {
      "type": "string",
      "format": "image",
      "description": "Zdj\u0119cie realizacji"
    },
    "alt": {
      "type": "string",
      "description": "Opis zdj\u0119cia dla czytnik\u00f3w ekranu"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Czy realizacja ma by\u0107 wyr\u00f3\u017cniona na stronie g\u0142\u00f3wnej"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Kolejno\u015b\u0107 wy\u015bwietlania (rosn\u0105co)"
    },
    "is_demo": {
      "type": "boolean",
      "default": true,
      "description": "Zdj\u0119cie demonstracyjne (do czasu podmiany na rzeczywiste)"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Widoczne na stronie"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}